# Database (PostgreSQL with pgvector)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rag_notebook"

# NextAuth
AUTH_SECRET="generate-a-random-string-here"
NEXTAUTH_URL="http://localhost:3000"

# Embedding model (SiliconFlow or any OpenAI-compatible service)
SILICONFLOW_API_KEY="your-api-key"
SILICONFLOW_BASE_URL="https://api.siliconflow.cn/v1"
SILICONFLOW_EMBEDDING_MODEL="BAAI/bge-m3"

# Chat model (SenseNova or any OpenAI-compatible service)
SENSENOVA_API_KEY="your-api-key"
SENSENOVA_BASE_URL="https://token.sensenova.cn/v1"
SENSENOVA_CHAT_MODEL="deepseek-v4-flash"
